# Copie para .env e preencha. Nunca versione o .env.

# Banco de dados
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/poupefruti

# Segredos (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
JWT_SECRET_KEY=

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Expiração do token JWT em segundos (padrão: 3600 = 1h)
JWT_ACCESS_TOKEN_EXPIRES=3600

# Tamanho mínimo da senha (padrão: 8)
MIN_PASSWORD_LENGTH=8

# development | production
FLASK_ENV=development
# Banco de dados (Neon). Use a connection string COM "-pooler".
DATABASE_URL=postgresql+psycopg://USER:SENHA@HOST/DATABASE?sslmode=require

# Segredos da aplicação. Gere valores longos e aleatórios.
SECRET_KEY=troque-por-um-valor-aleatorio-longo
JWT_SECRET_KEY=troque-por-outro-valor-aleatorio-longo

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=https://poupefruti.vercel.app

# Base pública da aplicação web. Usada nos links de convite:
# APP_BASE_URL + "/convite#token=..."
APP_BASE_URL=https://poupefruti.vercel.app

# Opcionais
# JWT_ACCESS_TOKEN_EXPIRES=3600
# MIN_PASSWORD_LENGTH=8
# FLASK_ENV=production
